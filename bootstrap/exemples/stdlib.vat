module std.io;

@export
@extern("c") @cname("open")
fn open(filename: str, flags: int, mode: int) -> int;

@export
@extern("c") @cname("write")
fn write(fd: int, buf: str, count: size_t) -> ssize_t;

@export
@extern("c") @cname("read")
fn read(fd: int, buf: str, count: size_t) -> ssize_t;

@export
@extern("c") @cname("close")
fn close(fd: int) -> int;
