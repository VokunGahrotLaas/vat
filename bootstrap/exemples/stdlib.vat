module std.io;

@export
@extern("c") @cname("open")
fn c_open(filename: str, flags: int, mode: int) -> int;

@export
@extern("c") @cname("write")
fn c_write(fd: int, buf: str, count: size_t) -> ssize_t;

@export
@extern("c") @cname("read")
fn c_read(fd: int, buf: str, count: size_t) -> ssize_t;

@export
@extern("c") @cname("close")
fn c_close(fd: int) -> int;

@export
let c_STDIN: int = 0;

@export
let c_STDOUT: int = 1;

@export
let c_STDERR: int = 2;

@extern("c") @cname("strlen")
fn c_strlen(s: str) -> size_t;

@export
fn print(s: str)
{
	c_write(c_STDOUT, s, c_strlen(s));
}
