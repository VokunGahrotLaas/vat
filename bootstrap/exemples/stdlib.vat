module std.io;

@export
@extern("c") @cname("open")
fn open(filename: str, flags: int, mode: int) -> int;

@export
@extern("c") @cname("write")
fn write(fd: int, buf: str, count: size_t) -> ssize_t;

@export
@extern("c") @cname("read")
fn read(fd: int, buf: str, count: size_t) -> ssize_t;

@export
@extern("c") @cname("close")
fn close(fd: int) -> int;

@export
let STDIN: int = 0;

@export
let STDOUT: int = 1;

@export
let STDERR: int = 2;

@extern("c") @cname("strlen")
fn strlen(s: str) -> size_t;

@export
fn print(s: str)
{
	write(STDOUT, s, strlen(s));
}

@export @cname("main")
fn main() -> int
{
	print("Hello World!\n");
	ret 0;
}
